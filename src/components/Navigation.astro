---
// src/components/Navigation.astro
import { Image } from "astro:assets";
import logoImg from "../assets/images/logo.png";

// Social links: change them here and they update everywhere
const socials = [
    { name: "Facebook", cls: "fb", href: "https://www.facebook.com/NorthstarsBoosterClub", path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" },
    { name: "X", cls: "x", href: "https://x.com/NKCSDNorthstars", path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.736-8.849L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" },
];
---

<div class="nav-wrapper" id="navWrapper">
    <nav>
        <a href="/" class="brand-container">
            <Image
                src={logoImg}
                alt="Northstars Booster Club Logo"
                class="logo-img"
            />
            <div class="brand-logo-text">NORTHSTARS BOOSTER CLUB</div>
        </a>
        <button
            type="button"
            class="mobile-menu-toggle"
            id="menuToggle"
            aria-label="Menu"
        >
            <span></span><span></span><span></span>
        </button>
        <div class="nav-links-container">
            <ul class="nav-links">
                <li class="nav-item">
                    <a href="/#sports">Our Sports</a>
                    <div class="dropdown">
                        <a href="/swimming">Swimming</a>
                        <a href="/track-and-field">Track</a>
                        <a href="/softball">Softball</a>
                        <a href="/bocce-ball">Bocce Ball</a>
                        <a href="/bowling">Bowling</a>
                        <a href="/basketball">Basketball</a>
                        <a href="/pickleball">Pickleball</a>
                        <a href="/powerlifting">Powerlifting</a>
                    </div>
                </li>
                <li class="nav-item">
                    <a href="/#involved">Get Involved</a>
                    <div class="dropdown">
                        <a href="/join">Join Northstars</a>
                        <a href="/volunteer">Volunteer</a>
                        <a href="/sponsor">Sponsor Northstars</a>
                    </div>
                </li>
                <li class="nav-item">
                    <a href="/who-we-are">Who We Are</a>
                    <div class="dropdown">
                        <a href="/who-we-are">About Us</a>
                        <a href="/sponsors">Our Sponsors</a>
                        <a href="/in-memory">In Memory</a>
                        <a href="/connect-with-us">Connect With Us</a>
                    </div>
                </li>
                {/* ATHLETE PORTAL: hidden until the portal is built.
                    To bring it back, delete this line and the closing line below.
                <li class="nav-item">
                    <a href="#portal">Athlete Portal</a>
                    <div class="dropdown">
                        <a href="#">Athlete Login</a>
                        <a href="#">Coach Portal</a>
                    </div>
                </li>
                */}
            </ul>
            <!-- Phone only: "Follow us" row at the bottom of the hamburger menu -->
            <div class="nav-follow-row">
                <span>Follow us</span>
                {socials.map((s) => (
                    <a
                        href={s.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`nav-social ${s.cls}`}
                        aria-label={`Northstars on ${s.name}`}
                        title={`Northstars on ${s.name}`}
                    >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} fill="currentColor" /></svg>
                    </a>
                ))}
            </div>
        </div>
    </nav>
    <!-- Desktop: social bubbles that trail the nav pill -->
    <div class="nav-socials">
                {socials.map((s) => (
                    <a
                        href={s.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`nav-social ${s.cls}`}
                        aria-label={`Northstars on ${s.name}`}
                        title={`Northstars on ${s.name}`}
                    >
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} fill="currentColor" /></svg>
                    </a>
                ))}
    </div>
</div>
