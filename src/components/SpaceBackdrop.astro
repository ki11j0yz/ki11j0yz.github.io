---
// src/components/SpaceBackdrop.astro
//
// A realistic, moving outer-space background for a whole page.
//
// HOW IT WORKS (big picture)
// - One <canvas> fills the screen and sits behind everything (z-index: -1).
// - A nebula (soft colored clouds) is painted once into a hidden canvas,
//   then copied onto the screen every frame. Painting it once keeps it fast.
// - Stars live in 4 depth layers. Far layers have many small, dim stars.
//   Near layers have fewer, bigger, brighter stars.
// - When you scroll or move the mouse, near layers move more than far ones.
//   That difference in speed (parallax) is what makes it feel 3D.
// - Each star twinkles slightly on its own rhythm.
//
// GOOD MANNERS
// - Visitors whose device is set to "reduce motion" get a still picture.
// - The animation pauses when the browser tab is hidden (saves battery).
// - It redraws correctly when the window is resized.
//
// TO USE ON A PAGE
//   import SpaceBackdrop from "../components/SpaceBackdrop.astro";
//   <SpaceBackdrop />   (put it first, inside <Layout>)
---

<canvas class="space-canvas" data-space-backdrop aria-hidden="true"></canvas>

<style>
    .space-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
        pointer-events: none;
        display: block;
        /* Shown for the split second before the canvas is drawn */
        background: #02030a;
    }
</style>

<script>
    // ---------- SETTINGS (safe to tweak) ----------
    // Each layer: depth (0 = infinitely far, 1 = closest), how many stars per
    // 10,000 square pixels of screen, and the star size range in pixels.
    const LAYERS = [
        { depth: 0.08, density: 3.6, minR: 0.3, maxR: 0.75, alpha: 0.65 },
        { depth: 0.2, density: 1.8, minR: 0.45, maxR: 1.1, alpha: 0.8 },
        { depth: 0.45, density: 0.6, minR: 0.7, maxR: 1.6, alpha: 0.9 },
        { depth: 0.85, density: 0.16, minR: 1.1, maxR: 2.4, alpha: 1.0 },
    ];
    const SCROLL_STRENGTH = 0.35; // how far stars drift as you scroll
    const MOUSE_STRENGTH = 28; // how far stars drift with the mouse (pixels, near layer)
    const MOUSE_EASE = 0.06; // how smoothly they follow the mouse (smaller = smoother)

    // Real star colors: mostly white, some blue-white, some warm
    const STAR_COLORS = [
        [255, 255, 255],
        [255, 255, 255],
        [255, 255, 255],
        [210, 225, 255],
        [180, 205, 255],
        [255, 240, 220],
        [255, 214, 170],
    ];

    type Star = {
        x: number;
        y: number;
        r: number;
        a: number;
        color: number[];
        speed: number;
        phase: number;
    };

    let cleanup: (() => void) | null = null;

    // A seeded random number generator, so the sky looks the same on every
    // page and every visit instead of reshuffling.
    function makeRandom(seed: number) {
        return () => {
            seed = (seed * 1664525 + 1013904223) % 4294967296;
            return seed / 4294967296;
        };
    }

    function start() {
        if (cleanup) cleanup();
        const canvas = document.querySelector<HTMLCanvasElement>("[data-space-backdrop]");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let width = 0;
        let height = 0;
        let dpr = 1;
        let layers: Star[][] = [];
        let nebula: HTMLCanvasElement | null = null;
        let glow: HTMLCanvasElement | null = null;
        let frame = 0;
        let running = false;

        // Mouse position, from -1 (left/top) to 1 (right/bottom), eased
        let mouseTargetX = 0;
        let mouseTargetY = 0;
        let mouseX = 0;
        let mouseY = 0;

        // A soft glow image used behind the brightest stars
        function makeGlow() {
            const g = document.createElement("canvas");
            g.width = g.height = 64;
            const gc = g.getContext("2d")!;
            const grad = gc.createRadialGradient(32, 32, 0, 32, 32, 32);
            grad.addColorStop(0, "rgba(255,255,255,0.9)");
            grad.addColorStop(0.15, "rgba(220,230,255,0.35)");
            grad.addColorStop(0.5, "rgba(170,190,255,0.06)");
            grad.addColorStop(1, "rgba(0,0,0,0)");
            gc.fillStyle = grad;
            gc.fillRect(0, 0, 64, 64);
            return g;
        }

        // ---- Noise: the building block for realistic, wispy clouds ----
        // "Value noise" gives smooth random hills. Stacking several sizes of it
        // (fractal noise) gives the uneven, filament-like texture of real gas.
        function makeNoise(seed: number) {
            const rand = makeRandom(seed);
            const SIZE = 256;
            const grid = new Float32Array(SIZE * SIZE);
            for (let i = 0; i < grid.length; i++) grid[i] = rand();
            const smooth = (t: number) => t * t * (3 - 2 * t);
            const at = (x: number, y: number) => grid[(y & 255) * SIZE + (x & 255)];
            const noise = (x: number, y: number) => {
                const xi = Math.floor(x), yi = Math.floor(y);
                const xf = smooth(x - xi), yf = smooth(y - yi);
                const top = at(xi, yi) + (at(xi + 1, yi) - at(xi, yi)) * xf;
                const bot = at(xi, yi + 1) + (at(xi + 1, yi + 1) - at(xi, yi + 1)) * xf;
                return top + (bot - top) * yf;
            };
            return (x: number, y: number) => {
                let sum = 0, amp = 0.5, freq = 1;
                for (let o = 0; o < 6; o++) {
                    sum += amp * noise(x * freq, y * freq);
                    freq *= 2.03;
                    amp *= 0.5;
                }
                return sum; // roughly 0..1
            };
        }

        // Paint the nebula once into a hidden canvas. It is a little larger
        // than the screen so it can drift without showing an edge.
        const OVERSCAN = 60;
        function makeNebula() {
            const nw = width + OVERSCAN * 2;
            const nh = height + OVERSCAN * 2;
            const n = document.createElement("canvas");
            n.width = Math.ceil(nw * dpr);
            n.height = Math.ceil(nh * dpr);
            const nc = n.getContext("2d")!;
            nc.scale(dpr, dpr);

            // Deep space base: near-black with a hint of navy
            const base = nc.createLinearGradient(0, 0, 0, nh);
            base.addColorStop(0, "#03040c");
            base.addColorStop(0.5, "#050818");
            base.addColorStop(1, "#020309");
            nc.fillStyle = base;
            nc.fillRect(0, 0, nw, nh);

            // The clouds are computed at 1/4 size (fast), then smoothly enlarged
            const SCALE = 4;
            const cw = Math.ceil(nw / SCALE);
            const ch = Math.ceil(nh / SCALE);
            const cloud = document.createElement("canvas");
            cloud.width = cw;
            cloud.height = ch;
            const cc = cloud.getContext("2d")!;
            const img = cc.createImageData(cw, ch);
            const shape = makeNoise(11); // where the gas is thick or thin
            const tint = makeNoise(23); // which color the gas is
            const dust = makeNoise(37); // dark dust lanes
            const big = Math.max(cw, ch);

            // Where on the screen the big cloud regions sit (x, y as 0..1, size)
            const regions = [
                { x: 0.8, y: 0.18, r: 0.42, w: 1.0 },
                { x: 0.12, y: 0.55, r: 0.4, w: 0.9 },
                { x: 0.6, y: 0.9, r: 0.34, w: 0.75 },
                { x: 0.38, y: 0.05, r: 0.22, w: 0.5 },
            ];

            // Color palette: deep blue, violet, magenta, teal, warm gold
            const blue = [60, 105, 255];
            const violet = [130, 65, 230];
            const magenta = [225, 80, 160];
            const teal = [30, 165, 215];
            const gold = [255, 170, 90];
            const mix = (a: number[], b: number[], t: number) => [
                a[0] + (b[0] - a[0]) * t,
                a[1] + (b[1] - a[1]) * t,
                a[2] + (b[2] - a[2]) * t,
            ];
            const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

            for (let y = 0; y < ch; y++) {
                for (let x = 0; x < cw; x++) {
                    const u = x / cw, v = y / ch;
                    // How strongly this spot sits inside a cloud region
                    let mask = 0;
                    for (const R of regions) {
                        const dx = (u - R.x) * (cw / big), dy = (v - R.y) * (ch / big);
                        const d2 = (dx * dx + dy * dy) / (R.r * R.r);
                        mask += R.w * Math.exp(-d2 * 2.2);
                    }
                    mask = Math.min(1, mask);
                    if (mask < 0.02) continue;

                    // Warp the coordinates by noise, so clouds swirl instead of sitting in blobs
                    const wx = x + (tint(x * 0.01, y * 0.01) - 0.5) * 40;
                    const wy = y + (tint(x * 0.01 + 50, y * 0.01 + 50) - 0.5) * 40;
                    const thick = shape(wx * 0.018, wy * 0.018);
                    let density = clamp01((thick - 0.38) / 0.4);
                    density = Math.pow(density, 1.8) * mask;

                    // Dust lanes eat into the glow
                    const lane = clamp01((dust(x * 0.03, y * 0.03) - 0.5) / 0.2);
                    density *= 1 - lane * 0.75;
                    if (density <= 0.002) continue;

                    // Color shifts across the cloud
                    const c1 = tint(x * 0.006 + 200, y * 0.006);
                    let col = mix(blue, violet, clamp01((c1 - 0.35) / 0.3));
                    col = mix(col, teal, clamp01((v - 0.65) / 0.35) * 0.8);
                    col = mix(col, magenta, clamp01((0.25 - v) / 0.25) * clamp01((0.6 - u) / 0.4) * 0.9);
                    col = mix(col, gold, clamp01((u - 0.82) / 0.18) * clamp01(1 - Math.abs(v - 0.62) / 0.2) * 0.8);
                    // The densest gas glows brighter and whiter, like an emission nebula
                    col = mix(col, [235, 235, 255], Math.pow(density, 2.5) * 0.5);

                    const i = (y * cw + x) * 4;
                    img.data[i] = col[0];
                    img.data[i + 1] = col[1];
                    img.data[i + 2] = col[2];
                    img.data[i + 3] = Math.min(255, density * 150);
                }
            }
            cc.putImageData(img, 0, 0);
            nc.imageSmoothingEnabled = true;
            nc.imageSmoothingQuality = "high";
            nc.globalCompositeOperation = "lighter";
            nc.drawImage(cloud, 0, 0, nw, nh);
            // A second, blurred pass adds the soft glow around the clouds
            nc.globalAlpha = 0.6;
            nc.filter = "blur(18px)";
            nc.drawImage(cloud, 0, 0, nw, nh);
            nc.filter = "none";
            nc.globalAlpha = 1;
            nc.globalCompositeOperation = "source-over";

            // A faint band of tiny stars across the sky, like the Milky Way
            const rand = makeRandom(7);
            for (let i = 0; i < nw * 1.6; i++) {
                const t = rand();
                const x = t * nw;
                const y = nh * (0.15 + t * 0.7) + (rand() - 0.5) * nh * 0.18;
                nc.fillStyle = `rgba(255,255,255,${0.08 + rand() * 0.22})`;
                nc.fillRect(x, y, 0.7, 0.7);
            }
            return n;
        }

        function makeStars() {
            const rand = makeRandom(42);
            const area = width * height;
            layers = LAYERS.map((L) => {
                const count = Math.min(1400, Math.round((area / 10000) * L.density));
                const stars: Star[] = [];
                for (let i = 0; i < count; i++) {
                    // Most stars are small; a few are large (like the real sky)
                    const size = Math.pow(rand(), 3);
                    stars.push({
                        x: rand() * width,
                        y: rand() * height,
                        r: L.minR + size * (L.maxR - L.minR),
                        a: L.alpha * (0.45 + rand() * 0.55),
                        color: STAR_COLORS[Math.floor(rand() * STAR_COLORS.length)],
                        speed: 0.4 + rand() * 1.6,
                        phase: rand() * Math.PI * 2,
                    });
                }
                return stars;
            });
        }

        function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = window.innerWidth;
            height = window.innerHeight;
            canvas!.width = Math.ceil(width * dpr);
            canvas!.height = Math.ceil(height * dpr);
            ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
            glow = glow || makeGlow();
            nebula = makeNebula();
            makeStars();
            draw(performance.now());
        }

        // Wraps a number into 0..max, so stars that drift off one edge
        // come back in on the other and the sky never runs out.
        function wrap(v: number, max: number) {
            return ((v % max) + max) % max;
        }

        function draw(time: number) {
            const t = time / 1000;
            mouseX += (mouseTargetX - mouseX) * MOUSE_EASE;
            mouseY += (mouseTargetY - mouseY) * MOUSE_EASE;
            const scroll = window.scrollY;

            ctx!.globalCompositeOperation = "source-over";
            // The nebula drifts very slightly too, so it reads as far away
            // (drawn at its real size, never stretched, so it stays crisp)
            const nx = -OVERSCAN - mouseX * MOUSE_STRENGTH * 0.05;
            const ny = -OVERSCAN - mouseY * MOUSE_STRENGTH * 0.05 - Math.min(OVERSCAN * 0.9, scroll * 0.02);
            ctx!.drawImage(nebula!, nx, ny, width + OVERSCAN * 2, height + OVERSCAN * 2);

            ctx!.globalCompositeOperation = "lighter";
            for (let li = 0; li < layers.length; li++) {
                const L = LAYERS[li];
                const ox = -mouseX * MOUSE_STRENGTH * L.depth;
                const oy = -mouseY * MOUSE_STRENGTH * L.depth - scroll * SCROLL_STRENGTH * L.depth;
                for (const s of layers[li]) {
                    const x = wrap(s.x + ox, width);
                    const y = wrap(s.y + oy, height);
                    const twinkle = reduceMotion ? 1 : 0.75 + 0.25 * Math.sin(t * s.speed + s.phase);
                    const a = s.a * twinkle;
                    const [cr, cg, cb] = s.color;
                    if (s.r > 1.3) {
                        // Bright, close stars get a soft halo
                        const gs = s.r * 9;
                        ctx!.globalAlpha = a * 0.55;
                        ctx!.drawImage(glow!, x - gs / 2, y - gs / 2, gs, gs);
                        ctx!.globalAlpha = 1;
                    }
                    ctx!.fillStyle = `rgba(${cr},${cg},${cb},${a})`;
                    ctx!.beginPath();
                    ctx!.arc(x, y, s.r, 0, Math.PI * 2);
                    ctx!.fill();
                }
            }
            ctx!.globalCompositeOperation = "source-over";
        }

        function loop(time: number) {
            draw(time);
            frame = requestAnimationFrame(loop);
        }

        function play() {
            if (reduceMotion || running) return;
            running = true;
            frame = requestAnimationFrame(loop);
        }

        function pause() {
            running = false;
            cancelAnimationFrame(frame);
        }

        function onMouse(e: MouseEvent) {
            mouseTargetX = (e.clientX / width) * 2 - 1;
            mouseTargetY = (e.clientY / height) * 2 - 1;
        }

        function onVisibility() {
            if (document.hidden) pause();
            else play();
        }

        // With reduced motion, redraw only when the page scrolls or resizes
        function onScrollStill() {
            draw(0);
        }

        let resizeTimer = 0;
        function onResize() {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resize, 150);
        }

        resize();
        window.addEventListener("resize", onResize);
        if (reduceMotion) {
            window.addEventListener("scroll", onScrollStill, { passive: true });
        } else {
            window.addEventListener("mousemove", onMouse, { passive: true });
            document.addEventListener("visibilitychange", onVisibility);
            play();
        }

        cleanup = () => {
            pause();
            window.removeEventListener("resize", onResize);
            window.removeEventListener("scroll", onScrollStill);
            window.removeEventListener("mousemove", onMouse);
            document.removeEventListener("visibilitychange", onVisibility);
            cleanup = null;
        };
    }

    // Your site uses Astro's page transitions, so start on every page load
    // and stop cleanly before leaving a page.
    document.addEventListener("astro:page-load", start);
    document.addEventListener("astro:before-swap", () => {
        if (cleanup) cleanup();
    });
</script>
