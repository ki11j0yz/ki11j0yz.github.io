---
// src/pages/pickleball.astro
// Everything on this page comes from the shared template in
// src/layouts/SportLayout.astro. This file only holds this sport's details.
import SportLayout from "../layouts/SportLayout.astro";
import hero from "../assets/images/pickleball_hero.png";

const sport = {
    slug: "pickleball",
    name: "Pickleball",
    tagline: "Fast rallies and friendly competition.",
    season: "Apr - Aug",

    // Practice Schedule card
    scheduleBadge: "When We Play",
    schedule: [{ label: "Sundays", detail: "4:00 PM - 5:00 PM" }],

    // What You Need card
    needs: ["A water bottle", "A pickleball paddle", "A positive Northstar attitude!"],

    resourcesUrl: "https://somo.org/pickleball/",

    // Register card
    registerLine: "Ready to rally?",
    registerButton: "Register to Play",
};
---

<SportLayout {...sport} hero={hero} />
