---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import SpaceBackdrop from "../components/SpaceBackdrop.astro";
import { Image, getImage } from "astro:assets";

// 1. Import Hero background and all 8 sports images from src/assets/images/
import heroMain from "../assets/images/hero_main.jpg";
import bowlingImg from "../assets/images/bowling_homepage.jpg";
import basketballImg from "../assets/images/basketball_homepage.jpg";
import swimmingImg from "../assets/images/swimming_homepage.jpg";
import trackImg from "../assets/images/track_homepage.jpg";
import softballImg from "../assets/images/softball_homepage.jpg";
import bocceImg from "../assets/images/bocceball_homepage.jpg";
import pickleballImg from "../assets/images/pickleball_homepage.jpg";
import powerliftingImg from "../assets/images/powerlifting_homepage.jpg";

// 2. Optimize the hero background image to modern WebP
const optimizedHero = await getImage({ src: heroMain, format: "webp" });

// 3. Define the sports data in one clean array
//    href = the address of that sport's page (the files in src/pages).
const sports = [
	{ name: "Bowling", season: "Sept - Nov", img: bowlingImg, href: "/bowling" },
	{ name: "Basketball", season: "Nov - Mar", img: basketballImg, href: "/basketball" },
	{ name: "Swimming", season: "Jan - May", img: swimmingImg, href: "/swimming" },
	{ name: "Track & Field", season: "Mar - May", img: trackImg, href: "/track-and-field" },
	{ name: "Softball", season: "Jun - Oct", img: softballImg, href: "/softball" },
	{ name: "Bocce Ball", season: "Jul - Oct", img: bocceImg, href: "/bocce-ball" },
	{ name: "Pickleball", season: "Apr - Aug", img: pickleballImg, href: "/pickleball" },
	{ name: "Powerlifting", season: "Mar - Jun", img: powerliftingImg, href: "/powerlifting" },
];

// 4. Define the "Ways to Support" cards in one clean array
//    newTab: true = opens in a new browser tab (used for outside sites)
const supportCards = [
	{
		badge: "Get Started",
		title: "Join Northstars",
		text: "New athletes and families: register, tell us about your athlete, and become a member.",
		button: "Join Now",
		href: "/join",
		newTab: false,
	},
	{
		badge: "Lend a Hand",
		title: "Volunteer",
		text: "Help make every event a success. No experience necessary!",
		button: "Get Started",
		href: "/volunteer",
		newTab: false,
	},
	{
		badge: "For Businesses",
		title: "Sponsor",
		text: "Showcase your local business and support our athletes.",
		button: "Learn More",
		href: "/sponsor",
		newTab: false,
	},
];
---

<Layout title="Northstars Booster Club | Supporting Special Olympics">
	<!-- Realistic moving space background (src/components/SpaceBackdrop.astro) -->
	<SpaceBackdrop />

	<!-- Hero Header with optimized background (unchanged) -->
	<header
		class="hero"
		style={`background-image: linear-gradient(rgba(0, 45, 86, 0.55), rgba(0, 45, 86, 0.35)), url('${optimizedHero.src}');`}
	>
		<h1>UNVEILING POTENTIAL</h1>
		<p>
			Supporting North Kansas City's Special Olympics athletes through
			competitive sports and community.
		</p>
	</header>

	<!-- Yellow stats bar (unchanged) -->
	<div class="stats-bar">
		<div class="stat-item">
			<h2>200+</h2>
			<p>Athletes</p>
		</div>
		<div class="stat-item">
			<h2>8</h2>
			<p>Sports</p>
		</div>
		<div class="stat-item">
			<h2>50+</h2>
			<p>Unified Partners</p>
		</div>
		<div class="stat-item">
			<h2>100%</h2>
			<p>Volunteer Run</p>
		</div>
	</div>

	<!-- Everything below the yellow bar: sponsor page look -->
	<main class="hp-content">
		<div class="hp-container">
			<!-- Section 1: Sports grid. The whole card is a link to that sport's page. -->
			<section id="sports">
				<h2 class="hp-heading">Our Sports Programs</h2>
				<div class="hp-sports-grid">
					{
						sports.map((sport) => (
							<a class="hp-sport-card hp-glass" href={sport.href}>
								<Image
									src={sport.img}
									alt={sport.name}
									width={480}
									height={300}
								/>
								<div class="hp-sport-body">
									<h3 class="hp-sport-name">{sport.name}</h3>
									<span class="hp-badge">{sport.season}</span>
									<span class="hp-sport-go">View Sport →</span>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<!-- Section 2: Ways to Support -->
			<section id="involved">
				<h2 class="hp-heading">Ways to Support</h2>
				<div class="hp-support-grid">
					{
						supportCards.map((card) => (
							<div class="hp-support-card hp-glass">
								<div class="hp-card-header">
									<span class="hp-badge">{card.badge}</span>
									<h3 class="hp-card-title">{card.title}</h3>
								</div>
								<div class="hp-card-body">
									<p class="hp-card-text">{card.text}</p>
									<a
										href={card.href}
										target={card.newTab ? "_blank" : undefined}
										rel={card.newTab ? "noopener noreferrer" : undefined}
										class="hp-btn"
									>
										{card.button}
									</a>
								</div>
							</div>
						))
					}
				</div>
				<p class="hp-donate">
					Want to give in another way?{" "}
					<a href="https://my.cheddarup.com/c/general-donation-82637/items" target="_blank" rel="noopener noreferrer">Make a donation of any amount</a>
				</p>
			</section>

			<!-- Section 3: Inspire video -->
			<section class="hp-inspire-card hp-glass">
				<div class="hp-inspire-video">
					<iframe
						src="https://www.youtube.com/embed/TNPusPOT6RI?rel=0"
						title="Inspire"
						allowfullscreen></iframe>
				</div>
				<div class="hp-inspire-words">
					<span class="hp-badge">Watch</span>
					<h2 class="hp-inspire-title">Inspire: Northstars</h2>
					<p class="hp-inspire-text">
						Check out this video about our student-athletes getting ready for state competition!
					</p>
					<div class="hp-caption">
						<strong>Video Caption:</strong> Some of the hardest working and most dedicated student-athletes are getting ready for state competition! As basketball players for NKCS Northstars practice, they{" "}<a href="https://www.youtube.com/hashtag/inspire" target="_blank" rel="noopener noreferrer" class="hp-hashtag">#iNspire</a>{" "}others with their passion for sports.
					</div>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	/* Every class below starts with "hp-" (home page) so it can never
	   collide with the older .sport-card, .join-card, .caption-box, etc.
	   rules in your global stylesheet. */

	/* 1. SPACE BACKGROUND: now the SpaceBackdrop component
	   (src/components/SpaceBackdrop.astro). Its styles live there. */

	/* =============================================
	   2. HOME CONTENT LAYOUT + SHARED PIECES
	   ============================================= */
	.hp-content {
		padding: 70px 20px 100px;
	}

	.hp-container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 80px;
	}

	/* Section headings ("Our Sports Programs", "Ways to Support") */
	.hp-heading {
		text-align: center;
		font-family: "Montserrat", sans-serif;
		font-size: 2.2rem;
		font-weight: 800;
		color: #ffffff;
		text-shadow: 0 0 12px rgba(0, 0, 0, 0.85);
		margin: 0 0 35px 0;
		letter-spacing: 1px;
		text-transform: none;
	}

	/* The glass card look (same recipe as .package-card on the sponsor page) */
	.hp-glass {
		background: linear-gradient(135deg, rgba(16, 28, 60, 0.75) 0%, rgba(8, 14, 32, 0.9) 100%);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-radius: 24px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
	}

	/* Yellow pill badge (same as .tier-badge on the sponsor page) */
	.hp-badge {
		display: inline-block;
		background: rgba(255, 205, 0, 0.15);
		border: 1px solid var(--accent-yellow);
		color: var(--accent-yellow);
		font-family: "Montserrat", sans-serif;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 4px 14px;
		border-radius: 50px;
	}

	/* =============================================
	   3. SPORTS GRID
	   Eight cards, four across. The whole card is a link.
	   ============================================= */
	.hp-sports-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 26px;
	}

	.hp-sport-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		color: #ffffff;
		text-decoration: none;
		transition:
			transform 0.35s ease,
			border-color 0.35s ease,
			box-shadow 0.35s ease;
	}

	.hp-sport-card:hover,
	.hp-sport-card:focus-visible {
		transform: translateY(-8px);
		border-color: var(--accent-yellow);
		box-shadow:
			0 20px 50px rgba(0, 0, 0, 0.8),
			0 0 25px rgba(255, 205, 0, 0.25);
		outline: none;
	}

	/* The photo. :global() is needed because the <img> is created by
	   Astro's Image component, not written directly in this file. */
	.hp-sport-card :global(img) {
		width: 100%;
		height: 190px;
		object-fit: cover;
		display: block;
	}

	.hp-sport-body {
		padding: 20px 20px 22px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.hp-sport-name {
		font-family: "Montserrat", sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0;
		letter-spacing: 0.5px;
		text-transform: none;
	}

	.hp-sport-go {
		font-family: "Montserrat", sans-serif;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(255, 255, 255, 0.6);
		transition: color 0.25s ease;
	}

	.hp-sport-card:hover .hp-sport-go,
	.hp-sport-card:focus-visible .hp-sport-go {
		color: var(--accent-yellow);
	}

	/* =============================================
	   4. WAYS TO SUPPORT
	   Three cards. Modeled on the sponsor page's package cards
	   ============================================= */
	.hp-support-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 26px;
		align-items: stretch;
	}

	.hp-donate {
		margin: 26px 0 0;
		text-align: center;
		color: rgba(255, 255, 255, 0.85);
		font-size: 1.05rem;
	}

	.hp-donate a {
		color: var(--accent-yellow);
		font-weight: 700;
	}

	.hp-donate a:hover {
		text-decoration: underline;
	}

	.hp-support-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition:
			transform 0.35s ease,
			border-color 0.35s ease,
			box-shadow 0.35s ease;
	}

	.hp-support-card:hover {
		transform: translateY(-8px);
		border-color: var(--accent-yellow);
		box-shadow:
			0 20px 50px rgba(0, 0, 0, 0.8),
			0 0 25px rgba(255, 205, 0, 0.25);
	}

	.hp-card-header {
		padding: 28px 22px 20px;
		text-align: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(0, 0, 0, 0.25);
	}

	.hp-card-header .hp-badge {
		margin-bottom: 12px;
	}

	.hp-card-title {
		font-family: "Montserrat", sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0;
		letter-spacing: 0.5px;
		text-transform: none;
	}

	.hp-card-body {
		padding: 24px 22px 26px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.hp-card-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.9);
		margin: 0 0 24px 0;
		text-align: center;
		flex: 1;
	}

	/* Button (same as .tier-btn on the sponsor page) */
	.hp-btn {
		width: 100%;
		display: block;
		text-align: center;
		background: rgba(255, 255, 255, 0.08);
		border: 1.5px solid rgba(255, 205, 0, 0.6);
		color: #ffffff;
		font-family: "Montserrat", sans-serif;
		font-size: 0.85rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		text-decoration: none !important;
		padding: 13px 18px;
		border-radius: 50px;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.hp-btn:hover {
		background: var(--accent-yellow);
		color: var(--midnight-navy);
		border-color: var(--accent-yellow);
		box-shadow: 0 0 25px rgba(255, 205, 0, 0.6);
	}

	/* =============================================
	   5. INSPIRE VIDEO CARD
	   Video on the left, words on the right
	   ============================================= */
	.hp-inspire-card {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 40px;
		align-items: center;
		padding: 40px;
		border: 2px solid var(--accent-yellow);
		box-shadow:
			0 15px 45px rgba(0, 0, 0, 0.75),
			0 0 25px rgba(255, 205, 0, 0.2);
	}

	/* Keeps the video at a 16:9 shape at any width */
	.hp-inspire-video {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
	}

	.hp-inspire-video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.hp-inspire-words .hp-badge {
		margin-bottom: 12px;
	}

	.hp-inspire-title {
		font-family: "Montserrat", sans-serif;
		font-size: 2rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 12px 0;
		text-transform: none;
	}

	.hp-inspire-text {
		font-size: 1.05rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.92);
		margin: 0 0 20px 0;
	}

	.hp-caption {
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-left: 3px solid var(--accent-yellow);
		border-radius: 14px;
		padding: 18px 20px;
		font-size: 0.9rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.85);
	}

	.hp-caption strong {
		color: #ffffff;
	}

	.hp-hashtag {
		color: var(--accent-yellow);
		font-weight: 700;
		text-decoration: underline;
		transition: color 0.2s ease;
	}

	.hp-hashtag:hover {
		color: #ffffff;
	}

	/* =============================================
	   6. RESPONSIVE
	   ============================================= */
	/* Tablets: sports go two across, video stacks above its words.
	   The three support cards stay three across. */
	@media (max-width: 1024px) {
		.hp-sports-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.hp-inspire-card {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}

	/* Small tablets: support cards stack so they do not get too narrow */
	@media (max-width: 860px) {
		.hp-support-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Phones */
	@media (max-width: 600px) {
		.hp-container {
			gap: 60px;
		}

		.hp-heading {
			font-size: 1.7rem;
		}

		/* Sports stay two across so the list is not eight screens long */
		.hp-sports-grid {
			gap: 14px;
		}

		.hp-sport-card :global(img) {
			height: 110px;
		}

		.hp-sport-body {
			padding: 14px 10px 16px;
			gap: 8px;
		}

		.hp-sport-name {
			font-size: 1rem;
		}

		.hp-sport-card .hp-badge {
			font-size: 0.65rem;
			padding: 3px 10px;
		}

		.hp-inspire-card {
			padding: 22px 18px;
		}

		.hp-inspire-title {
			font-size: 1.6rem;
		}
	}
</style>