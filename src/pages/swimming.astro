---
// src/pages/swimming.astro
// Everything on this page comes from the shared template in
// src/layouts/SportLayout.astro. This file only holds swimming's details.
import SportLayout from "../layouts/SportLayout.astro";
import hero from "../assets/images/swimming_hero.jpg";

const sport = {
    slug: "swimming",
    name: "Swimming",
    tagline: "Developing strength, confidence, and speed in the water.",
    season: "Jan - May",

    // Practice Schedule card
    scheduleBadge: "When We Swim",
    schedule: [{ label: "Friday Evenings", detail: "5:00 PM - 6:30 PM" }],

    // What You Need card
    needs: [
        "Current SOMO Medical Form",
        "Swimsuit, towel & goggles",
        "Fins (not required, but recommended)",
        "A water bottle to hydrate",
        "Long hair in a cap or ponytail",
        "A positive Northstar attitude!",
    ],

    // Swimming has its own "Who should join?" answers
    whoShouldJoin: [
        "Athletes of all skill levels are welcome!",
        "<strong>Non-Lap Swim:</strong> swimming ability not required.",
        "<strong>Lap Swim:</strong> must have the ability to swim 50 or more meters independently.",
        "Volunteers and Unified Partners (age peers) with at least basic swimming skills are welcome to join us!",
    ],

    // Register card
    registerLine: "Ready to make a splash?",
    registerButton: "Register to Swim",
};
---

<SportLayout {...sport} hero={hero} />
