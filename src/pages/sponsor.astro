---
// src/pages/sponsor.astro
import Layout from '../layouts/Layout.astro';
import SpaceBackdrop from '../components/SpaceBackdrop.astro';

// 2026-2027 Sponsorship Packages Data with tier keys for the form
const packages = [
  {
    name: 'Platinum Sponsor',
    price: '$350',
    tierKey: 'platinum',
    featured: true,
    badge: 'Premier Sponsor',
    perks: [
      'Recognition as a Platinum Sponsor at all our Northstars Booster Club Events',
      'Prominent Logo/Name Placement on our Northstars Booster Club Banner',
      'Prominent Logo/Name Placement on the back of our Athletes Shirts',
      'Four Sponsorship Shirts of your own',
      'Recognition on our Facebook Page',
      'Recognition on our Website'
    ]
  },
  {
    name: 'Gold Sponsor',
    price: '$250',
    tierKey: 'gold',
    featured: false,
    badge: 'Gold Tier',
    perks: [
      'Recognition as a Gold Sponsor at all our Northstars Booster Club Events',
      'Logo/Name Placement on our Northstars Booster Club Banner',
      'Logo/Name Placement on the back of our Athletes Shirts',
      'Three Sponsorship Shirts of your own',
      'Recognition on our Facebook Page',
      'Recognition on our Website'
    ]
  },
  {
    name: 'Silver Sponsor',
    price: '$150',
    tierKey: 'silver',
    featured: false,
    badge: 'Silver Tier',
    perks: [
      'Recognition as a Silver Sponsor at all our Northstars Booster Club Events',
      'Logo/Name Placement on our Northstars Booster Club Banner',
      'Logo/Name Placement on the back of our Athletes Shirts',
      'Two Sponsorship Shirts of your own',
      'Recognition on our Facebook Page',
      'Recognition on our Website'
    ]
  },
  {
    name: 'Bronze Sponsor',
    price: '$100',
    tierKey: 'bronze',
    featured: false,
    badge: 'Bronze Tier',
    perks: [
      'Recognition as a Bronze Sponsor at all our Northstars Booster Club Events',
      'Name Placement on our Northstars Booster Club Banner',
      'Name Placement on the back of our Athletes Shirts',
      'One Sponsorship Shirt of your own',
      'Recognition on our Facebook Page',
      'Recognition on our Website'
    ]
  },
  {
    name: 'Supporter',
    price: '$50',
    tierKey: 'supporter',
    featured: false,
    badge: 'Community Tier',
    perks: [
      'Recognition as a Supporter at all our Northstars Booster Club Events',
      'Your Name on the back of our Athletes Shirt'
    ]
  }
];

// CheddarUp General Sponsorship / Donation Link for convenient amounts
const cheddarUpUrl = "https://my.cheddarup.com/c/general-donation-82637/items";
---

<Layout title="Sponsor Northstars | 2026-2027 Sponsorship Packages">
  <!-- Realistic moving space background (src/components/SpaceBackdrop.astro) -->
  <SpaceBackdrop />

  <!-- Hero Header -->
  <header class="sponsor-hero">
    <h1>SPONSORSHIP PACKAGES: 2026–2027</h1>
    <p>Champion our athletes! Explore our sponsorship tiers or contribute a custom amount to support our competitive seasons.</p>
  </header>

  <main class="sponsor-content">
    <div class="sponsor-container">

      <!-- Section 1: Tier Packages Grid -->
      <section class="packages-section">
        <h2 class="section-heading">Select Your Sponsorship Level</h2>
        
        <div class="packages-grid">
          {packages.map((pkg) => (
            <div class={`package-card ${pkg.featured ? 'featured-card' : ''}`}>
              <div class="card-header">
                <span class="tier-badge">{pkg.badge}</span>
                <h3 class="tier-title">{pkg.name}</h3>
                <div class="tier-price">{pkg.price}</div>
              </div>

              <div class="card-body">
                <ul class="perks-list">
                  {pkg.perks.map((perk) => (
                    <li>
                      <span class="check-icon">✓</span>
                      <span>{perk}</span>
                    </li>
                  ))}
                </ul>

                <div class="tier-action">
                  <!-- Button triggers the interactive popup modal with tier pre-selected -->
                  <button 
                    type="button" 
                    class="tier-btn open-sponsor-modal" 
                    data-tier={pkg.tierKey}
                  >
                    Sponsor at {pkg.price}
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: Custom Amount / Convenience Donation Box -->
      <section class="custom-donate-card">
        <div class="custom-content">
          <span class="custom-badge">Flexible Giving</span>
          <h2 class="custom-title">Want to Sponsor at a Different Amount?</h2>
          <p class="custom-text">
            If you would like to contribute an amount convenient for you rather than selecting a package above, every single dollar helps provide team gear, practice facilities, and tournament entry fees for our athletes.
          </p>
          <div class="custom-action">
            <a 
              href={cheddarUpUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="custom-btn"
            >
              Click Here to Sponsor the Northstars Booster Club (with CheddarUp)
            </a>
          </div>
        </div>
      </section>

      <!-- Section 3: Check Payment & Tax Deduction Info -->
      <section class="info-card payment-card">
        <h2 class="card-title">Payment by Check & Tax Information</h2>
        
        <div class="check-box">
          <p class="check-line">
            <strong>Make checks payable to:</strong> <span class="highlight-navy">Northstars Booster Club</span>
          </p>
          <p class="tax-note">
            (Tax deduction documentation will be provided)
          </p>
          <p class="warm-close">
            We hope you will consider sponsoring our Athletes!
          </p>
        </div>

        <div class="current-sponsors-plug">
          <p>Looking for our current community champions?</p>
          <a href="/sponsors" class="view-partners-link">View Our Current Sponsors →</a>
        </div>
      </section>

    </div>
  </main>

  <!-- =============================================
       SPONSORSHIP INQUIRY POPUP MODAL
       ============================================= -->
  <div id="sponsorModal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-card">
      <button id="closeModalBtn" class="modal-close" aria-label="Close modal">&times;</button>
      
      <div class="modal-header">
        <span class="modal-badge">Partner With Us</span>
        <h2 class="modal-title">Sponsorship Information Request</h2>
        <p class="modal-subtitle">
          Thank you for considering sponsoring the Northstars! Fill out this form and our sponsorship coordinator will reach out with payment options, shirt sizes, and logo specifications.
        </p>
      </div>

      <form id="sponsorForm" class="modal-form">
        <!-- Contact Name -->
        <div class="form-group">
          <label class="field-label">Contact Name <span class="req-star">*</span></label>
          <div class="name-grid">
            <input type="text" name="firstName" required placeholder="First Name" class="form-control" />
            <input type="text" name="lastName" required placeholder="Last Name" class="form-control" />
          </div>
        </div>

        <!-- Business Name -->
        <div class="form-group">
          <label for="businessName" class="field-label">Business / Organization Name</label>
          <input type="text" id="businessName" name="businessName" placeholder="e.g. Acme Plumbing or Family Name" class="form-control" />
        </div>

        <!-- Email & Phone -->
        <div class="contact-grid">
          <div class="form-group">
            <label for="modalEmail" class="field-label">Email Address <span class="req-star">*</span></label>
            <input type="email" id="modalEmail" name="email" required placeholder="you@example.com" class="form-control" />
          </div>
          <div class="form-group">
            <label for="modalPhone" class="field-label">Phone Number <span class="req-star">*</span></label>
            <input type="tel" id="modalPhone" name="phone" required placeholder="(816) 000-0000" class="form-control" />
          </div>
        </div>

        <!-- Sponsorship Level Dropdown (Auto-selected by button click) -->
        <div class="form-group">
          <label for="sponsorTierSelect" class="field-label">Selected Sponsorship Level <span class="req-star">*</span></label>
          <select id="sponsorTierSelect" name="tier" required class="form-control select-control">
            <option value="platinum">Platinum Sponsor ($350)</option>
            <option value="gold">Gold Sponsor ($250)</option>
            <option value="silver">Silver Sponsor ($150)</option>
            <option value="bronze">Bronze Sponsor ($100)</option>
            <option value="supporter">Supporter ($50)</option>
            <option value="custom">Custom Amount / Flexible Giving</option>
          </select>
        </div>

        <!-- Questions / Comments -->
        <div class="form-group">
          <label for="modalComments" class="field-label">Questions, Shirt Sizes, or Logo Notes</label>
          <textarea id="modalComments" name="comments" rows="3" placeholder="Tell us if you have any questions, prefer check or card, etc." class="form-control"></textarea>
        </div>

        <!-- Submit Button -->
        <div class="modal-submit-wrap">
          <button type="submit" class="submit-btn">
            Submit Sponsorship Request
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Handle Modal Popup & Tier Pre-Selection
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('sponsorModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const tierSelect = document.getElementById('sponsorTierSelect') as HTMLSelectElement | null;
    const openButtons = document.querySelectorAll('.open-sponsor-modal');
    const sponsorForm = document.getElementById('sponsorForm');

    function openModal(tier: string | null) {
      if (tier && tierSelect) {
        tierSelect.value = tier;
      }
      modal?.classList.add('active');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; // prevent page scroll behind modal
    }

    function closeModal() {
      modal?.classList.remove('active');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click listener to each package button
    openButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tier = btn.getAttribute('data-tier');
        openModal(tier);
      });
    });

    // Close on 'X' button
    closeBtn?.addEventListener('click', closeModal);

    // Close on click outside modal card
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('active')) {
        closeModal();
      }
    });

    // Form Submit
    sponsorForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you! Your sponsorship request has been received. Our team will contact you shortly with confirmation.');
      closeModal();
    });
  });
</script>

<style>
  /* 1. SPACE BACKGROUND: now the SpaceBackdrop component
     (src/components/SpaceBackdrop.astro). Its styles live there. */

  /* =============================================
     2. HERO HEADER
     ============================================= */
  .sponsor-hero {
    height: 46vh;
    min-height: 340px;
    background: transparent;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #ffffff;
    padding: 0 10%;
  }

  .sponsor-hero h1 {
    font-size: 3.2rem;
    letter-spacing: 2px;
    margin-bottom: 15px;
    text-shadow: 0 4px 25px rgba(0, 0, 0, 0.9);
  }

  .sponsor-hero p {
    font-size: 1.15rem;
    max-width: 800px;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    line-height: 1.6;
  }

  /* =============================================
     3. CONTENT LAYOUT & PACKAGES GRID
     ============================================= */
  .sponsor-content {
    padding: 10px 20px 100px;
  }

  .sponsor-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .section-heading {
    text-align: center;
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.85);
    margin-bottom: 35px;
    letter-spacing: 1px;
  }

  /* A wrapping row that centers each line of cards, so a short
     last row (the bottom two) sits in the middle under the top three. */
  .packages-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    align-items: stretch;
  }

  .package-card {
    /* Three cards per row: one third of the row, minus the two 30px gaps */
    flex: 0 1 calc((100% - 60px) / 3);
    background: linear-gradient(135deg, rgba(16, 28, 60, 0.75) 0%, rgba(8, 14, 32, 0.9) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .package-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-yellow);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 205, 0, 0.25);
  }

  /* .featured-card (Platinum) no longer has its own always-on yellow border.
     It now looks like the other cards and turns yellow on hover, like they do. */

  .card-header {
    padding: 30px 30px 20px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.25);
  }

  .tier-badge {
    display: inline-block;
    background: rgba(255, 205, 0, 0.15);
    border: 1px solid var(--accent-yellow);
    color: var(--accent-yellow);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 12px;
  }

  .tier-title {
    font-size: 1.55rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .tier-price {
    font-family: 'Montserrat', sans-serif;
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent-yellow);
    text-shadow: 0 0 15px rgba(255, 205, 0, 0.4);
    line-height: 1;
  }

  .card-body {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .perks-list {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .perks-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
  }

  .check-icon {
    color: var(--accent-yellow);
    font-weight: 900;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .tier-action {
    margin-top: auto;
  }

  /* Interactive Button that triggers the modal */
  .tier-btn {
    width: 100%;
    display: block;
    text-align: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(255, 205, 0, 0.6);
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 14px 20px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tier-btn:hover {
    background: var(--accent-yellow);
    color: var(--midnight-navy);
    border-color: var(--accent-yellow);
    box-shadow: 0 0 25px rgba(255, 205, 0, 0.6);
  }

  /* =============================================
     4. CUSTOM CONVENIENT GIVING CARD
     ============================================= */
  .custom-donate-card {
    padding: 45px;
    background: linear-gradient(135deg, rgba(20, 45, 90, 0.8) 0%, rgba(10, 20, 45, 0.95) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    border: 2px solid var(--accent-yellow);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.75), 0 0 25px rgba(255, 205, 0, 0.2);
    text-align: center;
  }

  .custom-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .custom-badge {
    display: inline-block;
    background: var(--accent-yellow);
    color: var(--midnight-navy);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 12px;
  }

  .custom-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 15px;
  }

  .custom-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 30px;
  }

  .custom-btn {
    display: inline-block;
    background-image: var(--star-pattern), linear-gradient(135deg, rgba(20, 35, 75, 0.95) 0%, rgba(0, 0, 0, 0.98) 100%);
    background-color: var(--midnight-navy);
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none !important;
    border-radius: 50px;
    padding: 16px 36px;
    border: 2px solid var(--accent-yellow);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 15px rgba(255, 205, 0, 0.25);
    transition: all 0.3s ease;
  }

  .custom-btn:hover {
    background-image: none;
    background-color: var(--accent-yellow);
    color: var(--midnight-navy);
    border-color: var(--accent-yellow);
    box-shadow: 0 0 28px rgba(255, 205, 0, 0.7);
    transform: translateY(-3px);
  }

  /* =============================================
     5. PAYMENT BY CHECK & TAX DEDUCTION
     ============================================= */
  .info-card {
    padding: 45px;
    background: linear-gradient(135deg, rgba(16, 28, 60, 0.75) 0%, rgba(8, 14, 32, 0.9) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
  }

  .card-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.85);
    margin-bottom: 25px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 14px;
    text-align: center;
  }

  .check-box {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 28px 20px;
    text-align: center;
    margin-bottom: 30px;
  }

  .check-line {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .highlight-navy {
