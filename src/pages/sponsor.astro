  }

  .view-partners-link:hover {
    color: #ffffff;
  }

  /* =============================================
     6. INTERACTIVE MODAL STYLES
     ============================================= */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(3, 6, 17, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    padding: 20px;
    box-sizing: border-box;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-card {
    position: relative;
    max-width: 680px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    background: linear-gradient(135deg, rgba(16, 28, 60, 0.97) 0%, rgba(8, 14, 32, 0.98) 100%);
    border: 2px solid var(--accent-yellow);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 35px rgba(255, 205, 0, 0.3);
    padding: 40px;
    box-sizing: border-box;
    transform: scale(0.95) translateY(20px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay.active .modal-card {
    transform: scale(1) translateY(0);
  }

  /* Close X button */
