    position: absolute;
    top: 18px;
    right: 20px;
    background: transparent;
    border: none;
    color: var(--accent-yellow);
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    padding: 6px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .modal-close:hover {
    transform: scale(1.2);
    color: #ffffff;
  }

  .modal-header {
    margin-bottom: 25px;
    text-align: left;
  }

  .modal-badge {
    display: inline-block;
    background: rgba(255, 205, 0, 0.15);
    border: 1px solid var(--accent-yellow);
    color: var(--accent-yellow);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 50px;
    margin-bottom: 8px;
  }

  .modal-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .modal-subtitle {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Form Elements */
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .field-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  .req-star {
    color: var(--accent-yellow);
  }

  .name-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-control {
    width: 100%;
