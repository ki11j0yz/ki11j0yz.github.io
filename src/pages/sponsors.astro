---
// src/pages/sponsors.astro
//
import Layout from "../layouts/Layout.astro";
import SpaceBackdrop from "../components/SpaceBackdrop.astro";
import { Image } from "astro:assets";

// 2. Existing Sponsors
import modernLogHomes from '../assets/images/modernloghomes.png';
import richFarms from '../assets/images/richfarms.png';
import safeInHome from '../assets/images/safeinhome.png';
import atticStorage from '../assets/images/attic_storage.png';
import spiritPlumbing from '../assets/images/spiritplumbing.jpg';
import unlimitedRV from '../assets/images/unlimitedRV.png';

// 3. New Sponsors
import businessVaultAi from '../assets/images/business_vault_ai.png';
import christianBrothers from '../assets/images/christian_brothers_roofing.png';
import cumpys from '../assets/images/cumpys.png';
import dentistryChildren from '../assets/images/dentistry_for_children.png';
import happyRockDental from '../assets/images/happy_rock_dental.png';
import luminaHealth from '../assets/images/lumina_health.png';
import metroPark from '../assets/images/metropark_warehouses.png';
import papaRay from '../assets/images/papa_ray.png';
import reliancePaper from '../assets/images/reliance_paper.png';
import krahenbillCpa from '../assets/images/krahenbill_cpa.png';

// 4. All 16 Sponsors Data Array
const sponsors = [
  {
    name: 'Modern Log Homes',
    tagline: 'Supporting local athletics and community growth.',
    logo: modernLogHomes,
  },
  {
    name: 'Rich Farms',
    tagline: 'Bringing nature and support to the Northstars family.',
    logo: richFarms,
  },
  {
    name: 'Safe In Home',
    tagline: 'Dedicated to safety and inclusion for all athletes.',
    logo: safeInHome,
  },
  {
    name: 'Attic Storage',
    tagline: 'Our long-term partners in community support.',
    logo: atticStorage,
  },
  {
    name: 'Spirit Plumbing',
    tagline: 'Providing the flow of support our teams need.',
    logo: spiritPlumbing,
  },
  {
    name: 'Unlimited RV',
    tagline: 'Driving our mission forward with generous support.',
    logo: unlimitedRV,
  },
  {
    name: 'Business Vault AI',
    tagline: 'Innovative technology supporting our athlete community.',
    logo: businessVaultAi,
  },
  {
    name: 'Christian Brothers Roofing',
    tagline: 'Protecting homes and championing our athletes.',
    logo: christianBrothers,
  },
  {
    name: "Cumpy's Sports & Apparel",
    tagline: 'Custom apparel and screen printing for the community.',
    logo: cumpys,
  },
  {
    name: 'Dentistry for Children & Teens',
    tagline: 'Healthy smiles and happy children across the Northland.',
    logo: dentistryChildren,
  },
  {
    name: 'Happy Rock Dental',
    tagline: 'Cosmetic and family dentistry dedicated to our community.',
    logo: happyRockDental,
  },
  {
    name: 'Lumina Health',
    tagline: 'Direct primary care with compassion and excellence.',
    logo: luminaHealth,
  },
  {
    name: 'MetroPark Warehouses',
    tagline: 'Reliable warehousing and logistics supporting local sports.',
    logo: metroPark,
  },
  {
    name: 'In Memory of Papa Ray',
    tagline: 'In our hearts forever — 5/15/1956 - 8/20/2022.',
    logo: papaRay,
  },
  {
    name: 'Reliance Paper Company',
    tagline: 'Packaging and paper supplies serving Kansas City since 1959.',
    logo: reliancePaper,
  },
  {
    name: 'Krahenbill CPA Tax Services',
    tagline: 'Professional tax and accounting services for the Northland.',
    logo: krahenbillCpa,
  },
];
---

<Layout title="Our Sponsors | Northstars Booster Club">
    <!-- Realistic moving space background (src/components/SpaceBackdrop.astro) -->
    <SpaceBackdrop />

    <!-- Hero: words sit directly on the space background -->
    <header class="spn-hero">
        <h1>OUR SPONSORS</h1>
        <p>The community partners who make the Northstar magic possible.</p>
    </header>

    <div class="spn-content">
        <div class="spn-container">
            <!-- Sponsor cards -->
            <section>
                <h2 class="spn-heading">Championing Our Athletes</h2>
                <div class="spn-grid">
                    {
                        sponsors.map((sponsor) => (
                            <div class="spn-card">
                                <!-- White tile so every logo shows as designed -->
                                <div class="spn-logo-tile">
                                    <Image src={sponsor.logo} alt={sponsor.name} />
                                </div>
                                <h3 class="spn-name">{sponsor.name}</h3>
                                <p class="spn-tagline">{sponsor.tagline}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Call to action: links to the Sponsor Northstars page -->
            <section class="spn-cta">
                <span class="spn-cta-badge">Partner With Us</span>
                <h2 class="spn-cta-title">Want to see your logo here?</h2>
                <p class="spn-cta-text">Join our mission and help provide life-changing opportunities for our athletes.</p>
                <a href="/sponsor" class="spn-cta-btn">Become a Sponsor</a>
            </section>
        </div>
    </div>
</Layout>

<style>
    /* Every class below starts with "spn-" (sponsors page) so it can never
       collide with the older .section, .join-card, etc. rules in global.css. */

    /* =============================================
       1. HERO
       Modeled on .sponsor-hero (words directly on the background)
       ============================================= */
    .spn-hero {
        min-height: 340px;
        height: 50vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #ffffff;
        padding: 0 10%;
    }

    .spn-hero h1 {
        font-size: 3.4rem;
        letter-spacing: 3px;
        margin: 0 0 15px 0;
        color: #ffffff;
        text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9), 0 0 40px rgba(120, 150, 255, 0.35);
    }

    .spn-hero p {
        font-size: 1.15rem;
        max-width: 760px;
        margin: 0;
        color: rgba(255, 255, 255, 0.92);
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
        line-height: 1.6;
    }

    /* =============================================
       2. LAYOUT
       ============================================= */
    .spn-content {
        padding: 10px 20px 100px;
    }

    .spn-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 70px;
    }

    .spn-heading {
        text-align: center;
        font-family: "Montserrat", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        text-shadow: 0 0 14px rgba(0, 0, 0, 0.9);
        letter-spacing: 1px;
        margin: 0 0 35px 0;
        text-transform: none;
    }

    /* =============================================
       3. SPONSOR CARDS
       Same glass recipe as the package cards on the Sponsor Northstars page.
       A wrapping, centered row so a short last row sits in the middle.
       ============================================= */
    .spn-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 28px;
    }

    .spn-card {
        /* Three per row: one third of the row, minus the two 28px gaps */
        flex: 0 1 calc((100% - 56px) / 3);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 28px 26px 30px;
        background: linear-gradient(135deg, rgba(16, 28, 60, 0.72) 0%, rgba(8, 14, 32, 0.88) 100%);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
        transition:
            transform 0.35s ease,
            border-color 0.35s ease,
            box-shadow 0.35s ease;
    }

    .spn-card:hover {
        transform: translateY(-8px);
        border-color: var(--accent-yellow);
        box-shadow:
            0 20px 50px rgba(0, 0, 0, 0.8),
            0 0 25px rgba(255, 205, 0, 0.25);
    }

    .spn-logo-tile {
        background: #ffffff;
        width: 100%;
        height: 130px;
        padding: 15px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        margin-bottom: 22px;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04);
    }

    /* :global() is needed because the <img> is created by Astro's Image component */
    .spn-logo-tile :global(img) {
        max-width: 100%;
        max-height: 100px;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .spn-name {
        font-family: "Montserrat", sans-serif;
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--accent-yellow);
        margin: 0 0 10px 0;
        letter-spacing: 0.5px;
    }

    .spn-tagline {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.88);
        margin: 0;
    }

    /* =============================================
       4. CALL TO ACTION
       Same recipe as the "Flexible Giving" card on the Sponsor Northstars page
       ============================================= */
    .spn-cta {
        text-align: center;
        padding: 45px;
        background: linear-gradient(135deg, rgba(20, 45, 90, 0.78) 0%, rgba(10, 20, 45, 0.92) 100%);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-radius: 24px;
        border: 2px solid var(--accent-yellow);
        box-shadow:
            0 15px 45px rgba(0, 0, 0, 0.75),
            0 0 25px rgba(255, 205, 0, 0.2);
    }

    .spn-cta-badge {
        display: inline-block;
        background: var(--accent-yellow);
        color: var(--midnight-navy);
        font-family: "Montserrat", sans-serif;
        font-size: 0.75rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 4px 14px;
        border-radius: 50px;
        margin-bottom: 12px;
    }

    .spn-cta-title {
        font-family: "Montserrat", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 14px 0;
        text-transform: none;
    }

    .spn-cta-text {
        font-size: 1.1rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.92);
        max-width: 640px;
        margin: 0 auto 28px auto;
    }

    .spn-cta-btn {
        display: inline-block;
        background-image:
            var(--star-pattern),
            linear-gradient(135deg, rgba(20, 35, 75, 0.95) 0%, rgba(0, 0, 0, 0.98) 100%);
        background-color: var(--midnight-navy);
        color: var(--white);
        font-family: "Montserrat", sans-serif;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none !important;
        border-radius: 50px;
        padding: 16px 36px;
        border: 2px solid var(--accent-yellow);
        box-shadow:
            0 4px 15px rgba(0, 0, 0, 0.4),
            0 0 15px rgba(255, 205, 0, 0.25);
        transition: all 0.3s ease;
    }

    .spn-cta-btn:hover {
        background-image: none;
        background-color: var(--accent-yellow);
        color: var(--midnight-navy);
        border-color: var(--accent-yellow);
        box-shadow: 0 0 28px rgba(255, 205, 0, 0.7);
        transform: translateY(-3px);
    }

    /* =============================================
       5. RESPONSIVE
       ============================================= */
    /* Tablets: two per row */
    @media (max-width: 1024px) {
        .spn-card {
            flex-basis: calc((100% - 28px) / 2);
        }
    }

    /* Phones: one per row */
    @media (max-width: 640px) {
        .spn-hero h1 {
            font-size: 2.2rem;
        }

        .spn-heading,
        .spn-cta-title {
            font-size: 1.7rem;
        }

        .spn-card {
            flex-basis: 100%;
        }

        .spn-cta {
            padding: 30px 20px;
        }
    }
</style>
