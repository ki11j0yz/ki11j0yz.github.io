---
// src/pages/bowling.astro
// Everything on this page comes from the shared template in
// src/layouts/SportLayout.astro. This file only holds this sport's details.
import SportLayout from "../layouts/SportLayout.astro";
import hero from "../assets/images/bowling_hero.png";

const sport = {
    slug: "bowling",
    name: "Bowling",
    tagline: "Strikes, spares and Sundays with the team.",
    season: "Sept - Nov",

    // TODO (ask Tracy): bowling has a lane fee, so the yellow bar does not say FREE.
    // Once the fee is confirmed, replace null with e.g. { value: "$5", label: "Per Practice" }
    cost: null,

    // Practice Schedule card
    // TODO (ask Tracy): the practice time is not on the live site. When you have it,
    // change the first line to e.g. { label: "Sundays", detail: "2:00 PM - 4:00 PM" }
    scheduleBadge: "When We Bowl",
    schedule: [
        { label: "Sundays" },
        { label: "Be on time", detail: "late arrivals wait until the next game begins." },
    ],
    scheduleNote: "for practice times and updates.",

    // What You Need card
    needs: [
        "Your own shoes and ball, if you have them",
        "No gear? The bowling alley provides equipment",
        "A positive Northstar attitude!",
    ],

    // TODO (ask Tracy): this is the live site's wording about the fee. Confirm it is current.
    costAnswers: [
        "There is a $5 fee per athlete to cover lane rentals. The monthly total depends on the number of scheduled practices.",
        "Payment is due at the first session. Fees are non-refundable and subject to change.",
    ],

    resourcesUrl: "https://somo.org/bowling/",

    // Register card
    registerLine: "Ready to roll?",
    registerButton: "Register to Bowl",
};
---

<SportLayout {...sport} hero={hero} />
